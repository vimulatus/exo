# Postgres connection string. Used by the app (src/lib/db) and drizzle-kit.
#
# Local dev/testing — points at the docker-compose Postgres on host port 5434.
# Start it first: docker compose up -d
DATABASE_URL="postgres://exo:exo@localhost:5434/exo"

# Deployed envs use Neon instead; the db client auto-selects the Neon HTTP
# driver when the host matches *.neon.tech, e.g.:
# DATABASE_URL="postgres://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/exo?sslmode=require"

# Better Auth — session signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
# Public origin of the app; used for OAuth callbacks.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Google Workspace SSO). Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated email domains allowed to sign in. No public signup — the first
# allowed login provisions a Designer; all other domains are rejected.
# Unset/empty rejects everyone. Example: "acme.com,acme.io"
AUTH_ALLOWED_EMAIL_DOMAINS=""
